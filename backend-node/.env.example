# EventSphere backend-node environment
# Never commit real values.

NODE_ENV=production
DEMO_MODE=false
PORT=10000

# Comma-separated browser origins allowed to call this API.
CLIENT_URL=https://your-vercel-app.vercel.app
ALLOWED_ORIGINS=https://your-vercel-app.vercel.app

# MongoDB Atlas connection string.
DATABASE_URL=mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/eventsphere?retryWrites=true&w=majority

# Auth
JWT_SECRET=replace_with_64_plus_random_characters
JWT_EXPIRES_IN=7d

# Razorpay test/live keys
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=replace_with_razorpay_secret

# Flask AI service on Render
FLASK_AI_URL=https://your-eventsphere-ai.onrender.com

# Uploads and rate limiting
UPLOAD_DIR=uploads
MAX_FILE_SIZE=5242880
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
