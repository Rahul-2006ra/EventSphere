# EventSphere Flask AI service environment
# Never commit real values.

FLASK_ENV=production

# xAI is preferred when set. Gemini is used as fallback when XAI_API_KEY is blank.
AI_PROVIDER=xai
XAI_API_KEY=replace_with_xai_key
XAI_MODEL=grok-4.3
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# Allow the Node API and deployed frontend.
ALLOWED_ORIGINS=https://your-eventsphere-api.onrender.com,https://your-vercel-app.vercel.app
