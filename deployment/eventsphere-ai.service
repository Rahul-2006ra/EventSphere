[Unit]
Description=EventSphere Flask AI Microservice
Documentation=https://github.com/YOUR_USERNAME/eventsphere
After=network.target

[Service]
Type=simple
User=ubuntu
Group=ubuntu
WorkingDirectory=/var/www/eventsphere/ai-flask
Environment="PATH=/var/www/eventsphere/ai-flask/venv/bin"
EnvironmentFile=/var/www/eventsphere/ai-flask/.env
ExecStart=/var/www/eventsphere/ai-flask/venv/bin/gunicorn \
    --bind 127.0.0.1:8000 \
    --workers 2 \
    --timeout 30 \
    --access-logfile /var/log/eventsphere/flask-access.log \
    --error-logfile /var/log/eventsphere/flask-error.log \
    app:app
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
